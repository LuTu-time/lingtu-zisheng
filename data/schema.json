        { "n": "params", "t": "TEXT", "c": "NOT NULL DEFAULT '{}'", "d": "JSON 模块参数（阈值、速率等覆盖项）" },
        { "n": "reason", "t": "TEXT", "c": "NOT NULL DEFAULT ''", "d": "状态来源：默认 / 题材挂载 / 作者强制" }
      ],
      "indexes": [
        { "name": "idx_module_state", "cols": ["state"], "unique": false }
      ]
    },

